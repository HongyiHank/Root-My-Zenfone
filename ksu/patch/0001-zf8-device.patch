index ee34f98..eb20667 100644
--- a/kernel/hook/syscall_hook_manager.c
+++ b/kernel/hook/syscall_hook_manager.c
@@ -17,11 +17,18 @@
 
 #include "arch.h"
 #include "klog.h" // IWYU pragma: keep
+#include "uapi/supercall.h"   // ZF8: KSU_INSTALL_MAGIC1 for the reboot supercall
