diff --git a/kernel/supercall/supercall.c b/kernel/supercall/supercall.c
index 7fde216..08ab97e 100644
--- a/kernel/supercall/supercall.c
+++ b/kernel/supercall/supercall.c
@@ -91,6 +91,17 @@ int ksu_install_fd(void)
     return ksu_install_fd_with_permissions(O_CLOEXEC, 0);
 }
 
+/* ZF8: non-CLOEXEC variant. When the app (a zygote child) execs the
+   libksud child, the fd survives, so scan_driver_fd finds it directly and
+   the reboot-magic fallback is no longer needed (5.4 has no seccomp
+   action_cache, and the magic is blocked by the zygote seccomp filter
+   because secure_computing runs before trace_sys_enter). Built on the
+   upstream permissions parameter, only fd_flags = 0. */
+int ksu_install_fd_nocloexec(void)
+{
+    return ksu_install_fd_with_permissions(0, 0);
+}
