+#include "compat/kernel_compat.h"   // ZF8: ksu_get_uid_t
+#include "manager/manager_identity.h"   // ZF8: ksu_is_manager_uid
+#include "selinux/selinux.h"           // ZF8: is_zygote
+#include <linux/cred.h>                // ZF8: current_cred
 #include "hook/syscall_event_bridge.h"
 
 #ifdef CONFIG_KRETPROBES
@@ -97,6 +104,80 @@ static struct kretprobe *syscall_unregfunc_rp = NULL;
 // sys_enter handler: redirect hooked syscalls to the dispatcher
 static void ksu_sys_enter_handler(void *data, struct pt_regs *regs, long id)
 {
+#if defined(__aarch64__) && defined(CONFIG_KSU_ZF8_LATE_LOAD)
+    /* ZF8: the reboot supercall is handled entirely inside the tracepoint.
+       sys_call_table is never touched: its physical page is aliased a second
+       time through the chain's 3 GB device window, so writing it faults.
+       Only the on-stack regs are written (RW) and the handler is called
+       directly. magic1 == KSU_INSTALL_MAGIC1 installs the fd, sets
+       syscallno = NO_SYSCALL to suppress the real reboot and returns 0.
+       A reboot without the KSU magic is passed through unchanged. */
+    if (id == __NR_reboot) {
+        int magic1 = (int)regs->regs[0];
+        if (magic1 == KSU_INSTALL_MAGIC1) {
+            int magic2 = (int)regs->regs[1];
+            unsigned int cmd = (unsigned int)regs->regs[2];
+            void __user **arg = (void __user **)&regs->regs[3];
+            long r = ksu_handle_sys_reboot(magic1, magic2, cmd, arg);
+            regs->syscallno = -1;   /* NO_SYSCALL: skip invoke_syscall */
+            regs->regs[0] = (u64)r; /* syscall return value */
+            return;
+        }
+    }
+    /* ZF8: setresuid to the manager uid installs the fd. Running the full
+       ksu_handle_setuid here panics as soon as the app starts: in sys_enter
+       it reaches ksu_set_ksud_status, which takes kern_path() and
+       inode_lock(), i.e. sleeping locks. This path only checks three
+       conditions and calls ksu_install_fd():
+       (a) id == 147, setresuid (arm64 native; zygote calls it per child);
+       (b) is_zygote(current_cred()), so it only fires on the zygote->app
+           uid transition (tp_marker.c:92 already calls it under a spinlock,
+           which proves it is atomic-safe);
+       (c) the new uid is the manager uid: ksu_is_manager_uid(regs[0]).
+       ksu_install_fd is already proven safe in sys_enter by the reboot
+       interception path. Seccomp surgery, ksud immutable and umount are
+       skipped: the app only needs the fd and the ioctls. */
+    if (id == 147 && ksu_is_manager_uid((u32)regs->regs[0]) &&
+        is_zygote(current_cred())) {
+        pr_info("ZF8: zygote->manager uid=%d pid=%d, install fd\n",
+                (u32)regs->regs[0], current->pid);
+        ksu_install_fd_nocloexec();
+        /* Clear the zygote-wide seccomp policy now (it was inherited at
+           fork time). Upstream setuid_hook.c:123 does the same in its
+           allow-uid branch for kernels < 5.10: disable_seccomp() calls
+           put_seccomp_filter() under a spinlock and is atomic-safe (the
+           panic came from ksu_set_ksud_status and its inode_lock, not
+           from here). Together with the seccomp(2)/prctl suppression
+           below, the manager process carries no filter and its libksud
+           children can reach the reboot interception. */
+        disable_seccomp();
+    }
+    /* ZF8: suppress seccomp(2) installation for the manager process.
+       forkAndSpecialize order: fork -> setresuid(10249) (the point above,
+       filter not installed yet) -> setupSeccomp(), which installs AppPolicy
+       through seccomp(2) = 277. Every descendant of that process (the
+       libksud debug su forked and exec'd by libsu) then carries AppPolicy.
+       secure_computing runs before trace_sys_enter (ptrace.c:1847 < 1855),
+       so the reboot magic returns ERRNO before reaching the interception
+       above. Observed: the app's own fd 3 survived (the non-CLOEXEC
+       install worked) but the libksud child showed no ioctl at all, because
+       libcore's forkAndExec clears non-standard fds and the magic was
+       blocked as well. This suppression mirrors the syscallno = -1,
+       return 0 mechanism above; it matches only the manager uid, so
+       webview/renderer uids are unaffected. With no seccomp in the app,
+       the child's magic reaches the interception, the fd is installed,
+       GRANT_ROOT is issued ('allow root for: 10249') and the escape
+       completes. */
+    if ((id == 277 /* __NR_seccomp */ ||
+         (id == 167 /* __NR_prctl */ && (int)regs->regs[0] == 22 /* PR_SET_SECCOMP */)) &&
+        ksu_is_manager_uid(ksu_get_uid_t(current_uid()))) {
+        pr_info("ZF8: suppress seccomp for manager uid=%d pid=%d\n",
+                ksu_get_uid_t(current_uid()), current->pid);
+        regs->syscallno = -1;   /* NO_SYSCALL */
+        regs->regs[0] = 0;      /* seccomp(2) returns 0 = success */
+        return;
+    }
+#endif
 #if defined(__x86_64__)
     if (unlikely(in_compat_syscall()))
 #elif defined(__aarch64__)
@@ -123,6 +204,11 @@ static void ksu_sys_enter_handler(void *data, struct pt_regs *regs, long id)
 }
 #endif
 
+/* The old ksu_hook_reboot()/ksu_z8_reboot_direct() helpers were removed:
+   the inline reboot handling in ksu_sys_enter_handler() covers the whole
+   supercall, and the dispatcher path is unreachable under
+   CONFIG_KSU_NO_TABLE_PATCH (ksu_dispatcher_nr is always -1). */
+
 void __init ksu_syscall_hook_manager_init(void)
 {
     int ret;
@@ -133,7 +219,6 @@ void __init ksu_syscall_hook_manager_init(void)
     syscall_unregfunc_rp = init_kretprobe("syscall_unregfunc", syscall_unregfunc_handler);
 #endif
 
-    // Register syscall hooks via dispatcher
     ksu_register_syscall_hook(__NR_setresuid, ksu_hook_setresuid);
     ksu_register_syscall_hook(__NR_execve, ksu_hook_execve);
     ksu_register_syscall_hook(__NR_execveat, ksu_hook_execveat);
